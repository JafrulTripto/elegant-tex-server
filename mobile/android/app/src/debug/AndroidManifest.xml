<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only: allow cleartext HTTP so a local/dev API over http:// (e.g.
         http://10.0.2.2:8000) is reachable from the emulator. Release builds are
         unaffected and remain HTTPS-only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:usesCleartextTraffic="true" />
</manifest>
